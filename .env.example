# Loop.Talk configuration. Copy to .env.local for local work; on Vercel each key
# is a project environment variable. The server refuses to start when any key in
# the "required" block is missing or blank, and prints the offending names
# (see lib/env.ts and instrumentation.ts).
#
# Scope legend:
#   public  = NEXT_PUBLIC_* — inlined into the browser bundle at build time,
#             visible to every visitor; never put a secret here.
#   server  = read only on the server; never sent to the browser.

# ── Required ─────────────────────────────────────────────────────────────────

# public · absolute URL of the Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# public · Supabase publishable (anon) key; safe to expose, RLS protects the data
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# public · absolute URL the site is served from; used to build links in e-mails and share URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# server · Supabase secret (service-role) key; bypasses RLS for trusted server operations
SUPABASE_SECRET_KEY=sb_secret_...

# server · Daily.co REST API key; creates and deletes video rooms and mints meeting tokens
DAILY_CO_API_KEY=...

# server · shared secret used to verify Daily.co webhook signatures (POST /api/webhooks/daily)
DAILY_WEBHOOK_SECRET=...

# server · `pre` (waitlist landing, everything else redirects home) or `post` (the product)
LAUNCH_PHASE=post

# ── Optional: staging gate ──────────────────────────────────────────────────
# server · HTTP basic auth in front of every page. Leave both unset in
# production. Setting only one of the two is a configuration error.
#BASIC_AUTH_USER=
#BASIC_AUTH_PASS=

# ── Optional, with defaults (not validated at startup) ──────────────────────
# server · minutes before the start a participant may enter the room (default 10)
#SALA_EARLY_ENTRY_MINUTES=10
# server · hours before the start until which a guest may cancel (default 24)
#CANCEL_DEADLINE_HOURS=24
# server · Resend API key + verified sender; without them no confirmation e-mail is sent
#RESEND_API_KEY=
#RESEND_FROM="Loop.Talk <sessoes@your-domain>"
